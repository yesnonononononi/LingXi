<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>
    <groupId>com.summit</groupId>
    <artifactId>dp</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>LingXi</name>
    <description>LingXi</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>21</java.version>
        <!-- OkHttp 所需 Kotlin 版本不能被 Spring Boot 的默认版本覆盖。 -->
        <kotlin.version>2.2.21</kotlin.version>
        <lingxi.build.directory>${project.basedir}/target</lingxi.build.directory>
        <mybatis-plus>3.5.9</mybatis-plus>
        <!-- SQLite 只用于旧数据迁移验证，不进入运行包。 -->
        <sqlite-jdbc>3.54.1.0</sqlite-jdbc>
        <!-- 固定 H2 版本，保证 DDL、锁和大文本语义可复现。 -->
        <h2.version>2.5.252</h2.version>
        <lingxi-starter>1.1.8-SNAPSHOT</lingxi-starter>
        <ddd-starter>1.0.7</ddd-starter>
        <!-- 变异测试（Pitest）：用法与结果解读见 docs/mutation-testing.md -->
        <pitest.version>1.21.1</pitest.version>
        <!-- 覆盖率（JaCoCo）：`mvn -o test` 结束即出报告，报告目录 target/jacoco-report -->
        <jacoco.version>0.8.12</jacoco.version>
        <pitest.junit5.version>1.2.3</pitest.junit5.version>
        <!--
          默认门禁排除的 JUnit5 分组（surefire 的 excludedGroups）。

          为什么做成属性而不是写死：excludedGroups 一旦写死在 pom 里，`-Dgroups=network`
          和 `-Dtest=HttpClientNetworkComparisonTest` 都会被它压掉（实测都是 0 条），
          「按组/按类手动执行」就再也没有入口。留一个属性出口，默认值仍是 network：
            mvn -o clean test                                       → 排除 network
            mvn -o clean test -Dlingxi.surefire.excluded-groups= -Dgroups=network
                                                                    → 只跑 network 组
            mvn -o test -Dtest=HttpClientNetworkComparisonTest -Dlingxi.surefire.excluded-groups=
                                                                    → 直接点名该类
        -->
        <lingxi.surefire.excluded-groups>network</lingxi.surefire.excluded-groups>
        <!-- 默认目标只覆盖纯逻辑核心包，单次可接受；要跑别的范围用 -DtargetClasses=a.*,b.* 覆盖（逗号分隔由 Maven 拆成数组）。 -->
    </properties>
    <dependencies>
        <!-- 唯一运行期数据库为 H2。 -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite-jdbc}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus}</version>
        </dependency>
        <!-- MP 3.5.9 起分页插件拆分至此伴生包（PaginationInnerInterceptor 依赖 jsqlparser） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>${mybatis-plus}</version>
        </dependency>
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
            <version>5.8.42</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.5</version>
        </dependency>
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-3-starter</artifactId>
            <version>1.2.23</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yesnonononononi</groupId>
            <artifactId>lingxi-harness-spring-boot-starter</artifactId>
            <version>${lingxi-starter}</version>
        </dependency>
        <dependency>
            <groupId>io.github.yesnonononononi</groupId>
            <artifactId>harness-sandbox-mxc</artifactId>
            <version>${lingxi-starter}</version>
        </dependency>
        <dependency>
            <groupId>io.github.yesnonononononi</groupId>
            <artifactId>dev-framework-ddd-helper</artifactId>
            <version>${ddd-starter}</version>
        </dependency>

        <dependency>
            <groupId>io.github.java-diff-utils</groupId>
            <artifactId>java-diff-utils</artifactId>
            <version>4.15</version>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-http-client-okhttp</artifactId>
            <version>1.22.0-beta32</version>
        </dependency>
    </dependencies>

    <build>
        <directory>${lingxi.build.directory}</directory>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!--
              单元测试：版本继承 Spring Boot parent 的 pluginManagement（不写死版本），
              并且**只**增加 excludedGroups，不动其它配置（尤其不设 argLine —— JaCoCo 的
              prepare-agent 靠它注入 agent，覆盖掉就等于静默关掉覆盖率）。

              network 组：HttpClientNetworkComparisonTest（真实 TLS/本地端口，证书链环境敏感，
              共享机器上偶发失败，非代码缺陷）。它本来就在下面 pitest 的 excludedTestClasses 里，
              这里把 surefire 的口径统一过去，默认门禁不再偶发红灯。
              需要跑时：`mvn -o test -Dgroups=network` 或 `-Dtest=HttpClientNetworkComparisonTest`。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>${lingxi.surefire.excluded-groups}</excludedGroups>
                </configuration>
            </plugin>
            <!-- 变异测试：不绑定生命周期，只在显式执行 `mvn pitest:mutationCoverage` 时运行，不影响 test/package。 -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>${pitest.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>${pitest.junit5.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <!-- 默认目标=纯逻辑核心包；多 glob 必须写成多个 param，XML 里的逗号不会被拆分。 -->
                    <targetClasses>
                        <param>com.summit.dp.shared.utils.*</param>
                        <param>com.summit.dp.shared.vo.block.*</param>
                        <param>com.summit.dp.toolcall.domain.model.*</param>
                        <param>com.summit.dp.toolcall.application.convert.*</param>
                        <param>com.summit.dp.checklist.domain.model.*</param>
                        <param>com.summit.dp.turn.domain.model.*</param>
                        <param>com.summit.dp.session.domain.model.*</param>
                        <param>com.summit.dp.model.domain.model.*</param>
                    </targetClasses>
                    <!-- 结构性代码没有可辨别的行为差异，喂进去只会稀释分数、拉长耗时。 -->
                    <excludedClasses>
                        <param>com.summit.dp.*.api.*</param>
                        <param>com.summit.dp.*.infrastructure.*</param>
                        <param>*VO</param>
                        <param>*PO</param>
                        <param>*DTO</param>
                        <param>*Mapper</param>
                        <param>*Config</param>
                        <param>com.summit.dp.LingXiApplication</param>
                    </excludedClasses>
                    <!-- 环境敏感测试（本地起端口/子进程/真实网络/长超时）在 minion 里不稳定，会让整轮因基线不绿直接失败。 -->
                    <excludedTestClasses>
                        <param>com.summit.dp.agent.HttpClientNetworkComparisonTest</param>
                        <param>com.summit.dp.agent.StreamingRetryContractTest</param>
                        <param>com.summit.dp.agent.ChatControllerLifecycleTest</param>
                        <param>com.summit.dp.agent.StartupFailureEndToEndTest</param>
                        <param>com.summit.dp.model.PromptOptimizationTest</param>
                        <param>com.summit.dp.provider.ProviderModelDiscoveryTest</param>
                        <param>com.summit.dp.workspace.SandboxAmbientReadBoundaryTest</param>
                        <param>com.summit.dp.workflow.infrastructure.tools.image.*</param>
                        <param>com.summit.dp.mcp.*</param>
                    </excludedTestClasses>
                    <!-- 单测里 Spring/DB 用例动辄数秒，默认 3 秒超时会把它们误判成 TIMED_OUT。 -->
                    <timeoutConstant>10000</timeoutConstant>
                    <outputFormats>
                        <param>HTML</param>
                        <param>XML</param>
                    </outputFormats>
                    <!-- 固定报告目录，否则每次运行都堆一个带时间戳的新目录。 -->
                    <timestampedReports>false</timestampedReports>
                </configuration>
            </plugin>
            <!-- 覆盖率（JaCoCo）：随 `mvn -o test` 自动产出，不改变 test/package 的通过标准。
                 只出报告、不设 check 阈值 —— 历史代码的覆盖率是既成事实，先让它可见，再决定是否卡门禁。 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <!-- 固定报告目录，与 pitest 一样不希望每次运行都堆时间戳目录。 -->
                    <outputDirectory>${lingxi.build.directory}/jacoco-report</outputDirectory>
                    <!--
                      **只插我们的类**（agent 的 includes，VM 类名通配）。

                      为什么必须收窄：默认插桩范围是「所有被加载的类」，包括 Jackson、Spring 等三方库。
                      在本机 JDK 21.0.12.1 上实测到 C2 编译线程崩溃（`hs_err`：EXCEPTION_ACCESS_VIOLATION
                      @ jvm.dll，C2 正在编译 `Jackson POJOPropertiesCollector::_addFields`），
                      3 次带 agent 的全量跑 3 次崩、`-Djacoco.skip=true` 一次就绿 —— 崩溃由插桩后的三方字节码诱发。
                      覆盖率本来也只关心自己的代码，插三方库是白付 CPU 与风险。
                      （本地仓库离线只有 0.8.12，无法靠升级驱动规避，故从插桩范围上解决。）
                    -->
                    <includes>
                        <include>com/summit/**</include>
                    </includes>
                    <!-- 结构与生成代码没有可测行为：PO/Mapper/VO/DTO/Config 与启动类不计入分母。 -->
                    <excludes>
                        <exclude>**/*PO.class</exclude>
                        <exclude>**/*Mapper.class</exclude>
                        <exclude>**/*VO.class</exclude>
                        <exclude>**/*DTO.class</exclude>
                        <exclude>**/*Config.class</exclude>
                        <exclude>**/LingXiApplication.class</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
